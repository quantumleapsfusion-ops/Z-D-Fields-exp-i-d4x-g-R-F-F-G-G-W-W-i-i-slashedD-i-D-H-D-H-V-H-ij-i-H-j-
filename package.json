{
  "name": "earth-one",
  "private": true,
  "description": "Earth One Global Coalescent monorepo: earth1.co (corporate shell) and e1-4.com (earth life-forms).",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:e1-4": "npm run dev --workspace=e1-4-com",
    "dev:earth1": "npm run dev --workspace=earth1-co",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "npm run test:e2e --workspace=e1-4-com",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo run lint typecheck test build && npm run format:check"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "2.11.2"
  },
  "packageManager": "npm@10.9.9"
}

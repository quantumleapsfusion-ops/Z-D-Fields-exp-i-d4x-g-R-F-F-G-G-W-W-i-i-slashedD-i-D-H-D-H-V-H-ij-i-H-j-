# Public hostname Caddy will obtain a Let's Encrypt cert for (A record → the Hetzner box).
DAVINCI_HOST=davinci.e1-4.com

# Shared secret; the same value goes into Vercel as DAVINCI_SECRET. Generate: openssl rand -hex 32
DAVINCI_SECRET=

# Optional: only needed if a model repo is gated.
HF_TOKEN=

# Models (defaults shown). Pin VLLM_TAG to a tested release before going to production.
VLLM_TAG=latest
LLM_MODEL=Qwen/Qwen3.8-27B
LLM_MAX_LEN=32768
LLM_GPU_FRACTION=0.55
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_DIMENSIONS=1024
EMBED_GPU_FRACTION=0.05
STT_IMAGE=ghcr.io/speaches-ai/speaches:latest-cuda
STT_MODEL=Systran/faster-whisper-large-v3-turbo

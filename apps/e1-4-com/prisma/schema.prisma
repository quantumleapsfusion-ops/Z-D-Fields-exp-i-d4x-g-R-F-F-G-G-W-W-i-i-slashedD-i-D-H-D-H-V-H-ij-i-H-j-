// e1-4.com data model — Prisma on Supabase Postgres.
// Identity lives in Supabase Auth (`auth.users`); `users` is the app profile row with the same id.
// Every user-owned row cascades from `User`, so `hardDeleteUser` (lib/privacy/hard-delete.ts)
// only has to purge Storage objects, delete the profile row and then the auth user.
// Row Level Security + Storage policies: supabase/migrations/*.sql

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Profile row for a Supabase Auth user. `id` equals `auth.users.id`.
/// There is no email or password: identity is the user's voice (see VoicePrint).
model User {
  id          String   @id @db.Uuid
  displayName String?  @map("display_name")
  /// Public, lowercase `@handle` ([a-z0-9_]{3,20}) people use to find and add each other.
  handle      String?  @unique
  /// Object path inside the `avatars` bucket (e.g. "<uid>/avatar.png").
  avatarPath  String?  @map("avatar_path")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  stream      VoiceStream?
  shares      Share[]
  boards      Board[]
  usageEvents AiUsageEvent[]
  voicePrint  VoicePrint?

  conversationsStarted Conversation[]       @relation("ConversationCreator")
  memberships          ConversationMember[]
  voiceNotes           VoiceNote[]

  contacts  Contact[] @relation("ContactOwner")
  contactOf Contact[] @relation("ContactTarget")
  passkeys  Passkey[]

  @@map("users")
}

// ---------- Voice identity ----------

/// Enrolled voice of a user: the spoken voice name plus a speaker feature vector.
/// Verification finds candidates by `phraseHash`, then compares `embedding`
/// (see lib/voice/voiceprint.ts). Read and written only with the service role.
model VoicePrint {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  /// Normalised spoken voice name, e.g. "zachariah of earth".
  phrase      String
  /// sha256(phrase) — indexed lookup key for verification.
  phraseHash  String   @map("phrase_hash")
  /// Speaker feature vector (unit-normalised), averaged over enrolment samples.
  embedding   Float[]
  /// Number of samples folded into `embedding`.
  sampleCount Int      @default(1) @map("sample_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phraseHash])
  @@map("voice_prints")
}

// ---------- Voice Stream ----------

/// One continuous stream per user. Recording appends segments; it never creates posts.
model VoiceStream {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  segments VoiceSegment[]

  @@map("voice_streams")
}

enum TranscriptionStatus {
  PENDING
  DONE
  FAILED
  SKIPPED
}

/// A contiguous span of audio (record/resume → pause/stop) inside a user's stream.
model VoiceSegment {
  id                  String              @id @default(uuid()) @db.Uuid
  streamId            String              @map("stream_id") @db.Uuid
  /// Monotonic position inside the stream (0-based); playback stitches segments in this order.
  index               Int
  /// Object path inside the `voice` bucket: "<uid>/<streamId>/<segmentId>.<ext>".
  audioPath           String              @map("audio_path")
  mimeType            String              @map("mime_type")
  sizeBytes           Int                 @map("size_bytes")
  durationMs          Int                 @map("duration_ms")
  startedAt           DateTime            @map("started_at") @db.Timestamptz
  endedAt             DateTime            @map("ended_at") @db.Timestamptz
  transcription       String?
  transcriptionStatus TranscriptionStatus @default(PENDING) @map("transcription_status")
  transcriptionError  String?             @map("transcription_error")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz

  stream VoiceStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  shares Share[]

  @@unique([streamId, index])
  @@index([streamId, startedAt])
  @@map("voice_segments")
}

/// Unlisted link to a single segment (segmentId set) or to the whole stream (segmentId null).
model Share {
  id                String    @id @default(uuid()) @db.Uuid
  token             String    @unique
  userId            String    @map("user_id") @db.Uuid
  segmentId         String?   @map("segment_id") @db.Uuid
  includeAudio      Boolean   @default(true) @map("include_audio")
  includeTranscript Boolean   @default(true) @map("include_transcript")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment VoiceSegment? @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("shares")
}

// ---------- Talk (async voice conversations) ----------

/// A thread between two or more people. Anyone holding `inviteToken` can join after signing in.
model Conversation {
  id          String    @id @default(uuid()) @db.Uuid
  title       String?
  inviteToken String    @unique @map("invite_token")
  /// Set for one-to-one conversations opened from contacts: the two user ids, sorted, joined by ":".
  directKey   String?   @unique @map("direct_key")
  createdById String?   @map("created_by_id") @db.Uuid
  /// Bumped on every new note so the inbox can sort by recent activity.
  lastNoteAt  DateTime? @map("last_note_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  createdBy User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ConversationMember[]
  notes     VoiceNote[]

  @@index([lastNoteAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  /// Notes from others created after this are unread.
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz
  /// Set while the member is streaming live; `liveAt` is the last heartbeat.
  liveId         String?   @map("live_id") @db.Uuid
  liveAt         DateTime? @map("live_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

/// One recorded clip in a conversation. A live stream is a run of clips sharing `liveId`.
model VoiceNote {
  id                  String              @id @default(uuid()) @db.Uuid
  conversationId      String              @map("conversation_id") @db.Uuid
  senderId            String              @map("sender_id") @db.Uuid
  liveId              String?             @map("live_id") @db.Uuid
  /// Object path inside the `voice` bucket: "<senderId>/talk/<conversationId>/<noteId>.<ext>".
  audioPath           String              @map("audio_path")
  mimeType            String              @map("mime_type")
  sizeBytes           Int                 @map("size_bytes")
  durationMs          Int                 @map("duration_ms")
  startedAt           DateTime            @map("started_at") @db.Timestamptz
  endedAt             DateTime            @map("ended_at") @db.Timestamptz
  transcription       String?
  transcriptionStatus TranscriptionStatus @default(PENDING) @map("transcription_status")
  transcriptionError  String?             @map("transcription_error")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("voice_notes")
}

// ---------- Infinity Chalkboard ----------

model Board {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @default("Untitled board")
  /// Serialized board document (elements + viewport). See lib/chalkboard/types.ts.
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("boards")
}

// ---------- AI usage ledger (per-user rate limit + monthly spend cap) ----------

enum AiTier {
  EVERYDAY
  HEAVY
}

/// One row per model call. Drives the per-user rate limit and the monthly spend cap
/// (lib/ai/budget.ts). Cost is stored in micro-dollars (1 USD = 1_000_000).
model AiUsageEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  feature      String
  tier         AiTier
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  costMicros   BigInt   @map("cost_micros")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage_events")
}

/// Remembers which spend-cap thresholds were already announced for a month ("2026-09").
model AiBudgetAlert {
  month            String
  thresholdPercent Int      @map("threshold_percent")
  sentAt           DateTime @default(now()) @map("sent_at") @db.Timestamptz

  @@id([month, thresholdPercent])
  @@map("ai_budget_alerts")
}

/// Someone in your address book. One-directional: adding someone doesn't add you to theirs.
model Contact {
  ownerId   String   @map("owner_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner   User @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contact User @relation("ContactTarget", fields: [contactId], references: [id], onDelete: Cascade)

  @@id([ownerId, contactId])
  @@index([contactId])
  @@map("contacts")
}

/// A WebAuthn credential (passkey). `id` is the base64url credential id.
model Passkey {
  id         String    @id
  userId     String    @map("user_id") @db.Uuid
  publicKey  Bytes     @map("public_key")
  counter    Int       @default(0)
  transports String[]
  deviceType String    @map("device_type")
  backedUp   Boolean   @map("backed_up")
  name       String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/// Single-use WebAuthn challenge (registration or sign-in), valid for a few minutes.
model AuthChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  purpose   String
  challenge String
  userId    String?  @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("auth_challenges")
}

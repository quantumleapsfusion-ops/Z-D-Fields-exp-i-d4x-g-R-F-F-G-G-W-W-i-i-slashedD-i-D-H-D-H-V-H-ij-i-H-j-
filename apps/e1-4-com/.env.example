# ---- Supabase (Project Settings -> API) ----
# Safe to expose to the browser (the anon key is protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Postgres via Prisma (Project Settings -> Database -> Connection string) ----
# App runtime: transaction-mode pooler (port 6543).
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: direct connection (port 5432) or session-mode pooler.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Public site URL (used to build the OAuth redirect) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Feature flags (inlined at build time; experimental surfaces default OFF) ----
NEXT_PUBLIC_FEATURE_GRAVITY_BOARD=false
NEXT_PUBLIC_FEATURE_CHALKBOARD_3D=false
NEXT_PUBLIC_FEATURE_CHALKBOARD_4D=false

# ---- Speech-to-text (Voice Stream, Da Vinci). Optional: unset = transcription skipped ----
# whisper | deepgram | none. Defaults to whichever key is present (Deepgram first).
STT_PROVIDER=
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ---- LLM (Da Vinci, Gravity Board). Optional: unset = keyword stubs ----
# anthropic | openai | none. Defaults to Anthropic when ANTHROPIC_API_KEY is set.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Everyday Da Vinci work (summaries, labels, translation): claude-sonnet-5 or claude-haiku-4-5.
LLM_MODEL_EVERYDAY=claude-sonnet-5
# Gravity Board / heavy chalkboard breakdowns ONLY.
LLM_MODEL_HEAVY=claude-fable-5-1
# OpenAI fallback (used only when LLM_PROVIDER=openai or no Anthropic key).
OPENAI_MODEL=gpt-4o

# ---- AI budget: per-user rate limit + monthly spend cap ----
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=200
# Estimated spend across ALL users per UTC calendar month; calls return 402 once reached.
AI_MONTHLY_SPEND_CAP_USD=50
# Alerts at 80 % and 100 % of the cap. Webhook receives {"text": "..."} (Slack/Discord compatible).
AI_ALERT_WEBHOOK_URL=
# Optional e-mail alert via Resend.
AI_ALERT_EMAIL_TO=
AI_ALERT_EMAIL_FROM="e1-4 <alerts@e1-4.com>"
RESEND_API_KEY=
# Override list prices (USD per 1M tokens, [input, output]) to match your invoice.
# AI_MODEL_PRICES_JSON={"claude-sonnet-5":[3,15],"claude-haiku-4-5":[1,5],"claude-fable-5-1":[15,75]}

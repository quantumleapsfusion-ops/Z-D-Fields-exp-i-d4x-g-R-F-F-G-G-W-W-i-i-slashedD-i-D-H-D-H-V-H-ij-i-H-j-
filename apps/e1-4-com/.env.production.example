# Production values for the Vercel project `e1-4-com` (Settings -> Environment Variables).
# Everything here is REQUIRED unless marked optional. Never commit a filled-in copy.

# ---- Supabase (production project) ----
NEXT_PUBLIC_SUPABASE_URL=https://<prod-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Postgres via Prisma ----
# Runtime: transaction pooler (6543). Migrations: session pooler / direct (5432).
DATABASE_URL="postgresql://postgres.<prod-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<prod-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Public site URL: builds the OAuth redirect (`${NEXT_PUBLIC_SITE_URL}/auth/callback`) ----
# Must match, exactly, a URL listed under Supabase Authentication -> URL Configuration -> Redirect URLs.
# For Preview deployments set this to https://${VERCEL_BRANCH_URL} or leave it unset to use the
# Vercel-provided URL (see docs/DEPLOY.md).
NEXT_PUBLIC_SITE_URL=https://e1-4.com

# ---- Feature flags (inlined at build time) ----
NEXT_PUBLIC_FEATURE_GRAVITY_BOARD=false
NEXT_PUBLIC_FEATURE_CHALKBOARD_3D=false
NEXT_PUBLIC_FEATURE_CHALKBOARD_4D=false

# ---- Optional: speech-to-text ----
STT_PROVIDER=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# ---- Optional: LLM ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_EVERYDAY=claude-sonnet-5
LLM_MODEL_HEAVY=claude-fable-5-1

# ---- AI budget ----
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=200
AI_MONTHLY_SPEND_CAP_USD=50
AI_ALERT_WEBHOOK_URL=

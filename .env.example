# ---- Supabase (Project Settings -> API) ----
# Safe to expose to the browser (the anon key is protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Postgres via Prisma (Project Settings -> Database -> Connection string) ----
# App runtime: transaction-mode pooler (port 6543).
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: direct connection (port 5432) or session-mode pooler.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Public site URL (used to build the OAuth redirect) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Da Vinci (later) — speech-to-text ----
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# ---- Da Vinci (later) — LLM ----
ANTHROPIC_API_KEY=
# OPENAI_API_KEY above also covers GPT-4o

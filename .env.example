# ---------------------------------------------------------------------------
# e1-4.com — environment. Copy to `.env` and fill in what you need.
# Everything except DATABASE_URL + NEXTAUTH_SECRET is optional: missing keys
# disable a capability (a provider, transcription, LLM visuals) instead of
# crashing the app. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL, required) ---------------------------------------
DATABASE_URL="postgresql://e14:e14@localhost:5432/e14?schema=public"

# --- Auth (NextAuth.js) ------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Local-only email sign-in (no OAuth app needed). Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN="true"

# Google — https://console.cloud.google.com/apis/credentials
#   Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook — https://developers.facebook.com/apps
#   Redirect URI: {NEXTAUTH_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Microsoft (Entra ID / Azure AD) — https://entra.microsoft.com → App registrations
#   Redirect URI: {NEXTAUTH_URL}/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
# "common" allows personal + work accounts; use a tenant ID to restrict.
AZURE_AD_TENANT_ID="common"

# --- Object storage (audio blobs + avatars) ---------------------------------
# "local" writes under STORAGE_LOCAL_DIR (dev only). "s3" works with AWS S3 and Cloudflare R2.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/storage"
# Cloudflare R2: S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", S3_REGION="auto"
# AWS S3:        leave S3_ENDPOINT empty, S3_REGION="us-east-1" (etc.)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# --- Speech-to-text ----------------------------------------------------------
# Batch (Voice Stream segments): "deepgram" | "whisper" | "none". Empty = auto-detect by key.
# Live (Da Vinci / Chalkboard / Gravity): Deepgram streaming if DEEPGRAM_API_KEY is set,
# otherwise the browser's Web Speech API.
STT_PROVIDER=""
DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL="nova-2"
# Also used by the OpenAI LLM provider below.
OPENAI_API_KEY=""
OPENAI_WHISPER_MODEL="whisper-1"

# --- LLM (Da Vinci visuals + translate, Gravity Board superposition) --------
# "anthropic" | "openai" | "none". Empty = Anthropic if keyed, else OpenAI.
LLM_PROVIDER=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
OPENAI_MODEL="gpt-4o"

# --- Feature flags (inlined at build time) ----------------------------------
# Experimental prototype; launch inclusion undecided. OFF by default.
NEXT_PUBLIC_FEATURE_GRAVITY_BOARD="false"
# Infinity Chalkboard experimental 3D view (Three.js) and 4D placeholder.
NEXT_PUBLIC_FEATURE_CHALKBOARD_3D="false"
NEXT_PUBLIC_FEATURE_CHALKBOARD_4D="false"

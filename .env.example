# ---------------------------------------------------------------------------
# e1-4.com — environment. Copy to `.env` and fill in what you need.
# Supabase (auth, Postgres, storage) is the only required service; missing
# STT/LLM keys disable a capability instead of crashing. Never commit real values.
# ---------------------------------------------------------------------------

# --- Supabase project (Dashboard → Settings → API) --------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Used for Storage writes/signed URLs and auth.admin.deleteUser. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Postgres via Prisma (Dashboard → Settings → Database → Connection string) -
# Runtime: transaction-mode pooler, port 6543, pgbouncer=true.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations (`prisma migrate`): direct connection, port 5432.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Site -------------------------------------------------------------------
# Used to build the OAuth redirect (`{NEXT_PUBLIC_SITE_URL}/auth/callback`). Add it to
# Supabase → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- OAuth providers -----------------------------------------------------------
# Google, Facebook and Microsoft (Azure) client IDs/secrets are configured in the Supabase
# dashboard (Authentication → Providers), not here. Provider callback URL:
#   https://<project-ref>.supabase.co/auth/v1/callback

# --- Speech-to-text ----------------------------------------------------------
# Batch (Voice Stream segments): "deepgram" | "whisper" | "none". Empty = auto-detect by key.
# Live (Da Vinci / Chalkboard / Gravity): Deepgram streaming if DEEPGRAM_API_KEY is set,
# otherwise the browser's Web Speech API.
STT_PROVIDER=""
DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL="nova-2"
# Also used by the OpenAI LLM provider below.
OPENAI_API_KEY=""
OPENAI_WHISPER_MODEL="whisper-1"

# --- LLM (Da Vinci visuals + translate, Gravity Board superposition) --------
# "anthropic" | "openai" | "none". Empty = Anthropic if keyed, else OpenAI.
LLM_PROVIDER=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
OPENAI_MODEL="gpt-4o"

# --- Feature flags (inlined at build time) ----------------------------------
# Experimental prototype; launch inclusion undecided. OFF by default.
NEXT_PUBLIC_FEATURE_GRAVITY_BOARD="false"
# Infinity Chalkboard experimental 3D view (Three.js) and 4D placeholder.
NEXT_PUBLIC_FEATURE_CHALKBOARD_3D="false"
NEXT_PUBLIC_FEATURE_CHALKBOARD_4D="false"
